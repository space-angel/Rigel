{
  "name": "todoban",
  "productName": "todoBAN",
  "version": "0.1.0",
  "private": true,
  "description": "해야 하는 건 아는데 뭐부터 할지 몰라 시작을 못 할 때, 첫 행동을 찾아 주는 메뉴바·트레이 할 일 앱",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'src/**/*.test.ts'",
    "tray-icon": "node scripts/make-tray-icon.ts",
    "probe": "node scripts/claude-probe.ts",
    "i18n:check": "node scripts/i18n-check.ts",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "pretendard": "^1.3.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "author": {
    "name": "todoBAN"
  }
}
